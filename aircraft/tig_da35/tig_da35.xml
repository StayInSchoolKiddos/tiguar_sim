            <independentVar>velocities/mach</independentVar>
            <tableData>
                          0.0000   0.2000   
                          2.0000   0.0900   
                        </tableData>
          </table>
          <value>4.415248761576567</value>
        </product>
      </function>
      <function name="aero/coefficient/Cldr">
