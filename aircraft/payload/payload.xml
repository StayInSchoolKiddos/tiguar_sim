<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="http://jsbsim.sourceforge.net/JSBSim.xsl"?>
<fdm_config name="payload" version="2.0" release="BETA"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="http://jsbsim.sourceforge.net/JSBSim.xsd">

  <fileheader>
    <author>Justin</author>
    <version>1.1</version>
    <description>
      Payload + parachute/parafoil modeled as external reactions.
      4 servos (normalized [-1,1]) affect descent (drag/brakes) and steering (sideforce).
      - servo1, servo2: brake/sink control (drag multiplier)
      - servo3, servo4: steering (sideforce via differential)
    </description>
  </fileheader>

  <metrics>
    <wingarea unit="FT2"> 1 </wingarea>
    <wingspan unit="FT"> 1 </wingspan>
    <chord unit="FT"> 1 </chord>
    <htailarea unit="FT2"> 0 </htailarea>
    <htailarm unit="FT"> 0 </htailarm>
    <vtailarea unit="FT2"> 0 </vtailarea>
    <vtailarm unit="FT"> 0 </vtailarm>
    <location name="AERORP" unit="IN">
      <x> 0 </x><y> 0 </y><z> 0 </z>
    </location>
  </metrics>

  <mass_balance>
    <ixx unit="SLUG*FT2"> 2 </ixx>
    <iyy unit="SLUG*FT2"> 2 </iyy>
    <izz unit="SLUG*FT2"> 2 </izz>
    <emptywt unit="LBS"> 2.20462 </emptywt> <!-- 1 kg -->
    <location name="CG" unit="IN">
      <x> 0 </x><y> 0 </y><z> 0 </z>
    </location>
  </mass_balance>

  <!-- Minimal ground contact (recommended) -->
  <ground_reactions>
    <contact type="BOGEY" name="CONTACT">
      <location unit="IN">
        <x> 0 </x><y> 0 </y><z> 0 </z>
      </location>
      <static_friction> 0 </static_friction>
      <dynamic_friction> 0 </dynamic_friction>
      <rolling_friction> 0 </rolling_friction>
      <spring_coeff unit="LBS/FT"> 10000 </spring_coeff>
      <damping_coeff unit="LBS/FT/SEC"> 200000 </damping_coeff>
      <max_steer unit="DEG"> 0.0 </max_steer>
      <brake_group> NONE </brake_group>
      <retractable>0</retractable>
    </contact>
  </ground_reactions>

  <external_reactions>
    <!-- Declare properties we will drive from Python -->
    <property> fcs/parachute_reef_pos_norm </property>

    <property> fcs/servo1_cmd </property>
    <property> fcs/servo2_cmd </property>
    <property> fcs/servo3_cmd </property>
    <property> fcs/servo4_cmd </property>

    <!-- ==========================================
         Parachute drag: controls descent rate
         Drag magnitude ~ qbar * reef * Cd * Area * drag_mult
         drag_mult = 1 + k_brake * (servo1+servo2)/2
         ========================================== -->
    <force name="parachute_drag" frame="WIND">
      <function>
        <product>
          <property> aero/qbar-psf </property>
          <property> fcs/parachute_reef_pos_norm </property>

          <!-- Base CdA -->
          <value> 1.8 </value>   <!-- Cd -->
          <value> 1.0 </value>   <!-- Area ft^2 -->

          <!-- Brake-based drag multiplier -->
          <sum>
            <value> 1.0 </value>   <!-- baseline -->
            <product>
              <value> 0.5 </value> <!-- k_brake (tune 0.0..1.5) -->
              <product>
                <value> 0.5 </value> <!-- (servo1+servo2)/2 -->
                <sum>
                  <property> fcs/servo1_cmd </property>
                  <property> fcs/servo2_cmd </property>
                </sum>
              </product>
            </product>
          </sum>
        </product>
      </function>

      <location unit="FT">
        <x> 1 </x><y> 0 </y><z> 0 </z>
      </location>

      <direction>
        <x> -1 </x><y> 0 </y><z> 0 </z>
      </direction>
    </force>

    <!-- ==========================================
         Steering: WIND-frame sideforce (actual lateral motion)
         sideforce ~ qbar * reef * Cd * Area * k_steer * (servo4-servo3)/2
         ========================================== -->
    <force name="parachute_sideforce" frame="WIND">
      <function>
        <product>
          <property> aero/qbar-psf </property>
          <property> fcs/parachute_reef_pos_norm </property>

          <!-- Scale similarly to drag -->
          <value> 1.2 </value>
          <value> 1.0 </value>

          <product>
            <value> 0.35 </value> <!-- k_steer (tune 0.05..1.0) -->
            <product>
              <value> 0.5 </value> <!-- (servo4-servo3)/2 -->
              <sum>
                <property> fcs/servo4_cmd </property>
                <product>
                  <value> -1.0 </value>
                  <property> fcs/servo3_cmd </property>
                </product>
              </sum>
            </product>
          </product>
        </product>
      </function>

      <!-- Put this at same riser point as drag -->
      <location unit="FT">
        <x> 1 </x><y> 0 </y><z> 0 </z>
      </location>

      <!-- Side force in WIND frame -->
      <direction>
        <x> 0 </x><y> 1 </y><z> 0 </z>
      </direction>
    </force>

  </external_reactions>

  <propulsion/>

  <!-- You drive fcs/* from Python -->
  <flight_control name="FGFCS"/>

  <aerodynamics>
    <axis name="DRAG">
      <function name="aero/coefficient/CD">
        <description>Baseline drag</description>
        <product>
          <property>aero/qbar-psf</property>
          <property>metrics/Sw-sqft</property>
          <value>0.0001</value>
        </product>
      </function>
    </axis>
  </aerodynamics>

</fdm_config>
