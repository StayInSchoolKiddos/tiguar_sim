<?xml version="1.0"?>
<!-- DA35 piston approximation. Confirmed: Tiguar manual p8, 35 cc single cylinder,
     two strokes, 1650 idle, 7800 operating maximum. 4.5 hp is an UNVERIFIED seed prior.
     Remaining parameters are explicit simulation priors; see da35_calibration.json.
     maxrpm is a model reference speed, not an electronic governor or rev limiter. -->
<piston_engine name="DA35">
  <displacement unit="IN3">2.135831683</displacement>
  <cycles>2</cycles>
  <cylinders>1</cylinders>
  <idlerpm>1650</idlerpm>
  <maxrpm>7800</maxrpm>
  <maxhp unit="HP">4.5</maxhp>
  <minthrottle>0</minthrottle>
  <maxthrottle>1</maxthrottle>
  <!-- Assumed 38.1 mm bore; stroke calculated to retain 35 cc. -->
  <bore unit="IN">1.5</bore>
  <stroke unit="IN">1.208628431</stroke>
  <compression-ratio>8.5</compression-ratio>
  <volumetric-efficiency>0.85</volumetric-efficiency>
  <minmp unit="INHG">6.5</minmp>
  <maxmp unit="INHG">28.5</maxmp>
  <man-press-lag>0.1</man-press-lag>
  <static-friction unit="HP">0.03</static-friction>
  <dynamic-fmep unit="PA">18400</dynamic-fmep>
  <static-fmep unit="PA">46500</static-fmep>
  <peak-piston-speed>100</peak-piston-speed>
  <cylinder-head-mass unit="KG">0.12</cylinder-head-mass>
  <starter-rpm>3300</starter-rpm>
  <starter-torque>1.8</starter-torque>
</piston_engine>
